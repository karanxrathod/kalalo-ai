# ==============================================================
# Kalalo AI Captioning Studio & MCP Server — Environment Config
# Copy this file to .env and configure values for your environment.
# NEVER commit real API keys or secrets to version control.
# ==============================================================

NODE_ENV=development
LOG_LEVEL=info

# Default working directories
KALALO_OUTPUT_DIR=./output
KALALO_TEMP_DIR=./tmp
KALALO_DEFAULT_ASPECT_RATIO=9:16

# Speech-to-Text Provider: 'gemini' (recommended), 'openai', or 'mock' (offline testing)
KALALO_STT_PROVIDER=gemini
KALALO_STT_LANGUAGE=auto

# Gemini Model configuration (default: gemini-3.5-flash-lite)
KALALO_GEMINI_MODEL=gemini-3.5-flash-lite

# STT Credentials
# Users can also configure and encrypt their own API keys via the Studio Settings UI (/settings)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Authentication and Secrets Encryption
# Set strong random 256-bit strings for production deployments
JWT_SECRET=
KALALO_SECRET_KEY=
KALALO_MASTER_KEY=

# Optional custom binary paths (auto-detected if blank)
KALALO_FFMPEG_PATH=
KALALO_FFPROBE_PATH=
KALALO_PYTHON_PATH=
