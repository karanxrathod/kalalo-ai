# ==============================================================
# Kalalo AI Captioning Studio & MCP Server — Environment Config
# Copy this file to .env.local for Next.js development.
# NEVER commit real API keys or service role secrets to Git.
# ==============================================================

NODE_ENV=production
LOG_LEVEL=info

# ==============================================================
# 1. Supabase Backend Configuration (Primary Database & Storage)
# ==============================================================
# In Vercel: Set all three in Project Settings -> Environment Variables.
# NEXT_PUBLIC_* variables are accessible to both browser and server.
# SUPABASE_SERVICE_ROLE_KEY is strictly server-side (never exposed to browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket name for video and audio uploads (Default: kalalo-media)
SUPABASE_STORAGE_BUCKET=kalalo-media

# ==============================================================
# 2. Google Gemini AI Transcription (Required for Production STT)
# ==============================================================
# Set in Vercel environment variables (Server-side only).
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=AIzaSy...
# Recommended model: gemini-2.5-flash or gemini-2.5-flash-lite
KALALO_GEMINI_MODEL=gemini-2.5-flash
KALALO_STT_PROVIDER=gemini
KALALO_STT_LANGUAGE=auto

# ==============================================================
# 3. Security, Sessions & Encryption
# ==============================================================
# Generate a random 64-character secret for signing JWT sessions and encryption
JWT_SECRET=your-secure-random-64-character-jwt-secret-string
KALALO_SECRET_KEY=your-secure-random-64-character-encryption-secret

# ==============================================================
# 4. Storage & Processing Paths
# ==============================================================
# On Vercel serverless, temporary files are written to /tmp
KALALO_OUTPUT_DIR=./output
KALALO_TEMP_DIR=/tmp
KALALO_DEFAULT_ASPECT_RATIO=9:16

# ==============================================================
# 5. Optional Dedicated Background Worker (For Long Video Renders & Cutout)
# ==============================================================
# If running an external Docker worker on Railway/Render for videos > 60s
# or MediaPipe AI subject cutout compositing:
KALALO_WORKER_URL=
KALALO_WORKER_SECRET=

# ==============================================================
# 6. Optional Local Binary Overrides (Auto-detected if left empty)
# ==============================================================
KALALO_FFMPEG_PATH=
KALALO_FFPROBE_PATH=
KALALO_PYTHON_PATH=
